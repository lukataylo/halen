<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Mac App Store build. Must match the provisioning profile. -->
    <key>com.apple.security.app-sandbox</key><true/>
    <!-- Your side of the call. -->
    <key>com.apple.security.device.audio-input</key><true/>
    <!-- One-time download of the on-device voice-check model (Hugging Face). -->
    <key>com.apple.security.network.client</key><true/>
    <key>com.apple.application-identifier</key><string>5QC5886P5V.dev.halen.eq</string>
    <key>com.apple.developer.team-identifier</key><string>5QC5886P5V</string>
    <key>keychain-access-groups</key><array><string>5QC5886P5V.dev.halen.eq</string></array>
</dict>
</plist>
